{
  "name": "Python Customer API",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "forwardPorts": [8000],
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "containerEnv": {
    "ENVIRONMENT": "local",
    "DATABASE_NAME": "customer",
    "DEPENDENCY_DATABASE_TYPE": "memory"
  }
}
